{
    "name": "blackpig-creatif/magistere",
    "description": "A semi-headless Events, Workshops and Classes plugin for Filament PHP",
    "keywords": [
        "BlackpigCreatif",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "magistere"
    ],
    "homepage": "https://github.com/blackpig/magistere",
    "support": {
        "issues": "https://github.com/blackpig/magistere/issues",
        "source": "https://github.com/blackpig/magistere"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Blackpig Creatif",
            "email": "stuart@blackpig.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.3",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
"laravel/boost": "^2.2",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "BlackpigCreatif\\Magistere\\": "src/",
            "BlackpigCreatif\\Magistere\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlackpigCreatif\\Magistere\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlackpigCreatif\\Magistere\\MagistereServiceProvider"
            ],
            "aliases": {
                "Magistere": "BlackpigCreatif\\Magistere\\Facades\\Magistere"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": []
}
